```

## 4. 后端API设计

### 4.1 认证模块 (Auth)
```typescript
// 认证控制器
@Controller('auth')
export class AuthController {
  @Post('register')        // 用户注册
  @Post('login')           // 用户登录
  @Post('logout')          // 用户登出
  @Post('refresh')         // 刷新token
  @Post('forgot-password') // 忘记密码
  @Post('reset-password')  // 重置密码
}
```

### 4.2 用户模块 (Users)
```typescript
@Controller('users')
export class UsersController {
  @Get('profile')          // 获取用户资料
  @Put('profile')          // 更新用户资料
  @Get('family-members')   // 获取家庭成员
  @Post('invite')          // 邀请家庭成员
}
```

### 4.3 相册模块 (Albums)
```typescript
@Controller('albums')
export class AlbumsController {
  @Get()                   // 获取相册列表
  @Post()                  // 创建相册
  @Get(':id')              // 获取相册详情
  @Put(':id')              // 更新相册
  @Delete(':id')           // 删除相册
  @Post(':id/photos')      // 上传照片
  @Delete(':id/photos/:photoId') // 删除照片
}
```

### 4.4 文件模块 (Files)
```typescript
@Controller('files')
export class FilesController {
  @Get()                   // 获取文件列表
  @Post('upload')          // 上传文件
  @Get('download/:id')     // 下载文件
  @Delete(':id')           // 删除文件
  @Post('folders')         // 创建文件夹
  @Get('storage-usage')    // 获取存储使用情况
}
```

### 4.5 文章模块 (Articles)
```typescript
@Controller('articles')
export class ArticlesController {
  @Get()                   // 获取文章列表
  @Post()                  // 创建文章
  @Get(':id')              // 获取文章详情
  @Put(':id')              // 更新文章
  @Delete(':id')           // 删除文章
  @Post(':id/like')        // 点赞文章
  @Post(':id/comment')     // 评论文章
}
```

